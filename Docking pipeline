def find_pocket_boxes(prot_path, work_dir):
    """Find cavities with KVFinder and return a list of (center, size, volume).

    The list holds up to MAX_CAVITIES largest cavities, biggest first.
    Returns an empty list if no cavity was found or something went wrong.
    """
    kv = load_pykvfinder()
    if kv is None:
        return []

    os.makedirs(work_dir, exist_ok=True)
    pdb_path = os.path.join(work_dir, "kvfinder_input.pdb")
    # Only the protein itself (no water, ligands, ions) goes to KVFinder
    pdbqt_file_to_pdb(prot_path, pdb_path, skip_h=True, protein_only=True)

    import logging

    logging.disable(logging.WARNING)  # silence 'atom not found in dictionary'
    try:
        import numpy as np

        vdw = kv.read_vdw()
        atomic = kv.read_pdb(pdb_path, vdw)
        vertices = kv.get_vertices(atomic, probe_out=KV_PROBE_OUT, step=KV_STEP)
        ncav, cavities = kv.detect(
            atomic,
            vertices,
            step=KV_STEP,
            probe_in=KV_PROBE_IN,
            probe_out=KV_PROBE_OUT,
            removal_distance=KV_REMOVAL_DISTANCE,
            volume_cutoff=KV_VOLUME_CUTOFF,
        )
        if ncav == 0:
            print("  -> KVFinder found no cavities.")
            return []

        # Cavity labels start from 2; sort them by the number of grid points
        counts = np.bincount(cavities[cavities > 1].ravel())
        labels = [int(l) for l in np.argsort(counts)[::-1] if counts[l] > 0]
        volumes = {l: int(counts[l]) * KV_STEP**3 for l in labels}
        chosen = [l for l in labels if volumes[l] >= MIN_CAVITY_VOLUME]
        if not chosen:
            chosen = labels[:1]
        chosen = chosen[:MAX_CAVITIES]

        result = []
        origin = np.asarray(vertices[0])
        for label in chosen:
            coords = origin + np.argwhere(cavities == label) * KV_STEP
            center = [round(float(c), 3) for c in coords.mean(axis=0)]
            result.append((center, [AUTO_BOX_SIZE] * 3, volumes[label]))
        print(f"  -> Cavities found: {ncav}, selected for docking: {len(result)}")
        return result
    except Exception as e:
        print(f"  -> Pocket search failed: {e}")
        return []
    finally:
        logging.disable(logging.NOTSET)


def finalize_ligand(item, run, prot_file, table_header):
    """Save the chosen run of a ligand as its final result and clean up."""
    os.replace(run["tmp"], item["out_pdbqt"])
    for t in item["tmp_files"]:
        if os.path.exists(t):
            os.remove(t)

    box = run["box"]
    table_text = (
        "=========================================\n"
        "            POSE SUMMARY TABLE\n"
        "=========================================\n"
        f"Protein: {prot_file}\n"
        f"Ligand: {item['lig_file']}\n"
        f"Box: {box['name']}, center {box['center']}, size {box['size']}\n\n"
        + table_header
        + "\n"
        + "\n".join(run["rows"])
        + "\n=========================================\n"
    )
    with open(item["table_path"], "w", encoding="utf-8") as f:
        f.write(table_text)
    return run["rows"][0].split()[1], box["name"]


def write_summary(path_base, header, rows, score_index):
    """Write <path_base>.txt (tab-separated) and <path_base>.csv.

    Rows are sorted by the score column, best (most negative) first.
    """
    rows = sorted(rows, key=lambda r: float(r[score_index]))
    with open(path_base + ".txt", "w", encoding="utf-8") as f:
        f.write("\t".join(header) + "\n")
        for row in rows:
            f.write("\t".join(row) + "\n")
    with open(path_base + ".csv", "w", encoding="utf-8-sig", newline="") as f:
        writer = csv.writer(f)
        writer.writerow(header)
        writer.writerows(rows)


