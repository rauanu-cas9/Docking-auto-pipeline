REQUIRED_MODULES = ("rdkit", "meeko", "openbabel.pybel")
PIP_NAMES = {"openbabel": "openbabel-wheel"}


def ensure_packages():
    tried = set()
    for _ in range(20):
        try:
            for module in REQUIRED_MODULES:
                importlib.import_module(module)
            return
        except ModuleNotFoundError as e:
            name = (e.name or "").split(".")[0]
            if not name:
                raise
            package = PIP_NAMES.get(name, name)
            if package in tried:
                print(f"Library {package} is installed but cannot be imported.")
                print(f"Try manually: pip install --force-reinstall {package}")
                sys.exit(1)
            tried.add(package)

            print(f"Missing library {package}. Installing via pip...")
            try:
                subprocess.check_call(
                    [sys.executable, "-m", "pip", "install", package]
                )
            except (subprocess.CalledProcessError, OSError) as err:
                print(f"Could not install the library automatically: {err}")
                print(f"Install it manually with: pip install {package}")
                sys.exit(1)
            importlib.invalidate_caches()

    print("Could not prepare the libraries: too many missing dependencies.")
    sys.exit(1)


ensure_packages()

