CHIMERAX_PATH = ""

# --- Protein preparation -----------------------------------------------------
# True: remove everything except the protein (ligands from the crystal,
#       cofactors, ions, buffer molecules). Water is always removed.
# False: keep all of it (it then counts as part of the receptor in Vina).
REMOVE_HETATM = True
KEEP_METAL_IONS = True      # with REMOVE_HETATM, still keep metals such as Zn, Fe

# --- Docking (AutoDock Vina) -------------------------------------------------
EXHAUSTIVENESS = 8          # search effort when the box is known (higher = slower)
BLIND_EXHAUSTIVENESS = 16   # search effort for blind docking (whole protein)
NUM_MODES = 5               # poses Vina returns per ligand
MIN_PROTEIN_RESIDUES = 20   # a .pdb with fewer amino acids is treated as a ligand
DEFAULT_BOX_PADDING = 10.0  # extra size (A) added to the blind-docking box

# --- Box selection -----------------------------------------------------------
# Order of priority: context.txt -> automatic cavity search -> blind docking.
AUTO_POCKET = True          # search for cavities when context.txt is missing
AUTO_BOX_SIZE = 20.0        # box edge (A) around each found cavity
MAX_CAVITIES = 2            # dock into the N largest cavities of every protein
MIN_CAVITY_VOLUME = 50.0    # cavities smaller than this (A^3) are skipped

# False: every ligand uses its own best cavity (shows where it binds).
# True:  one common cavity per protein is chosen for all ligands (best mean
#        score), so the scores of different ligands can be compared.
COMPARE_LIGANDS = False

# --- KVFinder cavity detection -----------------------------------------------
KV_STEP = 0.6               # grid spacing (A)
KV_PROBE_IN = 1.4           # inner probe (A)
KV_PROBE_OUT = 8.0          # outer probe (A), larger = only deeper pockets
KV_REMOVAL_DISTANCE = 2.4   # (A)
KV_VOLUME_CUTOFF = 5.0      # (A^3) ignore tiny cavities inside KVFinder

# --- ChimeraX output ---------------------------------------------------------
MAX_POSES = 5               # poses per ligand that get a snapshot and a frame
USE_KVFINDER = True         # show KVFinder cavities in ChimeraX
# Snapshot names: <protein>_<ligand>_pose<N>.png. With True, the part that is
# the same in all ligand names is cut off: PubChem_search_records_14 -> lig14.
SHORT_SNAPSHOT_NAMES = True
CAVITY_COLOR = "#00b140"    # color of the cavities in ChimeraX

