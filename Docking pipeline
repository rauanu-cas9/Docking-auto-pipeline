def run_preparation():
    print("=== [STAGE 1] Preparing files ===")

    current_dir = base_dir()
    prot_folder = os.path.join(current_dir, "protein_output")
    lig_folder = os.path.join(current_dir, "ligand_output")
    os.makedirs(prot_folder, exist_ok=True)
    os.makedirs(lig_folder, exist_ok=True)
    clear_pdbqt(prot_folder)
    clear_pdbqt(lig_folder)

    protein_files = []
    ligand_files = []

    for file in sorted(os.listdir(current_dir), key=natural_key):
        full_path = os.path.join(current_dir, file)
        if not os.path.isfile(full_path):
            continue
        kind = classify_file(full_path)
        if kind == "protein":
            protein_files.append(file)
        elif kind == "ligand":
            ligand_files.append(file)

    print(
        f"Protein files found: {len(protein_files)}, ligand files found:"
        f" {len(ligand_files)}\n"
    )

    for prot_file in protein_files:
        input_path = os.path.join(current_dir, prot_file)
        base_name = os.path.splitext(prot_file)[0]
        output_path = os.path.join(prot_folder, f"{base_name}.pdbqt")

        print(f"Cleaning and processing protein: {prot_file}...")
        try:
            with open(input_path, "r", encoding="utf-8", errors="ignore") as f_in:
                lines = f_in.readlines()

            cleaned_lines = []
            removed_het = set()
            for line in lines:
                if line.startswith("ENDMDL"):
                    break
                if line.startswith("ATOM") or line.startswith("TER"):
                    cleaned_lines.append(line)
                elif line.startswith("HETATM"):
                    resname = line[17:20].strip().upper()
                    if resname in WATER_NAMES:
                        continue
                    if (
                        REMOVE_HETATM
                        and resname not in AMINO_ACIDS
                        and not (KEEP_METAL_IONS and resname in METAL_IONS)
                    ):
                        removed_het.add(resname)
                        continue
                    cleaned_lines.append(line)

            if removed_het:
                print(f"  -> Removed HETATM: {', '.join(sorted(removed_het))}")

            if not any(l.startswith(("ATOM", "HETATM")) for l in cleaned_lines):
                print("  -> No protein atoms in the file.")
                continue

            mol = pybel.readstring("pdb", "".join(cleaned_lines))
            mol.addh()
            mol.write("pdbqt", output_path, overwrite=True, opt={"r": None})
            print(f"  -> Cleaned and saved to {output_path}")
        except Exception as e:
            print(f"  -> Error: {e}")

    preparator = MoleculePreparation()

    for lig_file in ligand_files:
        input_path = os.path.join(current_dir, lig_file)
        base_name = os.path.splitext(lig_file)[0]
        ext = os.path.splitext(lig_file)[1].lower()

        print(f"Converting ligands from file: {lig_file}...")

        try:
            mols = read_ligands(input_path, ext)
        except Exception as e:
            print(f"  -> Error reading file {lig_file}: {e}")
            continue

        if not mols:
            print(f"  -> Could not read molecules from {lig_file}.")
            continue

        print(f"  -> Molecules found: {len(mols)}")

        for idx, mol in enumerate(mols, start=1):
            try:
                mol = Chem.AddHs(mol, addCoords=True)

                if mol.GetNumConformers() == 0 or not mol.GetConformer().Is3D():
                    mol.RemoveAllConformers()
                    if AllChem.EmbedMolecule(mol, AllChem.ETKDGv3()) != 0:
                        print(f"    - Could not build a 3D structure for molecule {idx}.")
                        continue
                    if AllChem.MMFFOptimizeMolecule(mol) == -1:
                        AllChem.UFFOptimizeMolecule(mol)

                setup = preparator.prepare(mol)[0]
                pdbqt_string, is_ok, error_msg = PDBQTWriterLegacy.write_string(setup)

                if not is_ok:
                    print(f"    - Meeko error for molecule {idx}: {error_msg}")
                    continue

                if len(mols) > 1:
                    output_filename = f"{base_name}_{idx}.pdbqt"
                else:
                    output_filename = f"{base_name}.pdbqt"

                output_path = os.path.join(lig_folder, output_filename)
                with open(output_path, "w", encoding="utf-8") as f_out:
                    f_out.write(pdbqt_string)
                print(f"    - Ligand written successfully: {output_filename}")
            except Exception as e:
                print(f"    - Error processing molecule {idx}: {e}")

    print("=== [STAGE 1] Preparation finished ===\n")


def run_docking():
    print("=== [STAGE 2] Running docking ===")

    current_dir = base_dir()
    prot_folder = os.path.join(current_dir, "protein_output")
    lig_folder = os.path.join(current_dir, "ligand_output")
    results_root = os.path.join(current_dir, "results")
    os.makedirs(results_root, exist_ok=True)

    vina_path = find_vina()
    if not vina_path:
        print(
            "Error: Vina not found. Put vina.exe next to the script or add it"
            " to PATH."
        )
        return

    boxes, context_ok = read_context(current_dir)
    if not context_ok:
        return

    if not os.path.exists(prot_folder) or not os.path.exists(lig_folder):
        print("Error: protein_output or ligand_output folders not found!")
        return

    proteins = sorted(
        [f for f in os.listdir(prot_folder) if f.endswith(".pdbqt")],
        key=natural_key,
    )
    ligands = sorted(
        [f for f in os.listdir(lig_folder) if f.endswith(".pdbqt")],
        key=natural_key,
    )

    print(f"Proteins found: {len(proteins)}, ligands found: {len(ligands)}\n")

    if not proteins or not ligands:
        print("No .pdbqt files for docking in the folders.")
        return

    if boxes is not None:
        if len(boxes) == 1 and len(proteins) > 1:
            print(
                "Warning: context.txt has one box, so it is used for all proteins."
                " It must fit the coordinate system of each one.\n"
            )
        elif len(boxes) < len(proteins):
            print(
                f"Error: context.txt has {len(boxes)} box(es) (6 numbers each),"
                f" but there are {len(proteins)} proteins. Add the missing"
                " numbers."
            )
            return
        else:
            if len(boxes) > len(proteins):
                print(
                    f"Warning: context.txt has {len(boxes)} boxes, but only"
                    f" {len(proteins)} proteins. Extra boxes are ignored."
                )
            print("Boxes from context.txt are assigned to proteins in order:")
            for prot_file, (c, s) in zip(proteins, boxes):
                print(f"  {prot_file}: center {c}, size {s}")
            print()

    table_header = (
        "mode |   affinity | dist from best mode\n"
        "     | (kcal/mol) | rmsd l.b.| rmsd u.b.\n"
        "-----+------------+----------+----------"
    )
    row_pattern = re.compile(r"^\s*\d+\s+-?\d+\.\d+\s+\d+\.\d+\s+\d+\.\d+\s*$")
    all_summary = []

    for p_idx, prot_file in enumerate(proteins, start=1):
        prot_name = os.path.splitext(prot_file)[0]
        prot_path = os.path.join(prot_folder, prot_file)
        prot_results = os.path.join(results_root, prot_name, "docking")
        os.makedirs(prot_results, exist_ok=True)

        exhaustiveness = EXHAUSTIVENESS
        if boxes is not None:
            c, sz = boxes[0] if len(boxes) == 1 else boxes[p_idx - 1]
            prot_boxes = [{"center": c, "size": sz, "name": "context.txt box"}]
        else:
            prot_boxes = []
            if AUTO_POCKET:
                print(f"\nSearching for cavities in {prot_file}...")
                found = find_pocket_boxes(
                    prot_path, os.path.join(current_dir, "temp_poses", prot_name)
                )
                for k, (c, sz, vol) in enumerate(found, start=1):
                    prot_boxes.append(
                        {"center": c, "size": sz, "name": f"cavity {k} (~{vol:.0f} A^3)"}
                    )
            if prot_boxes:
                for b in prot_boxes:
                    print(f"  -> {b['name']}: center {b['center']}, size {b['size']}")
                with open(
                    os.path.join(results_root, prot_name, "box.txt"),
                    "w",
                    encoding="utf-8",
                ) as f:
                    for b in prot_boxes:
                        values = " ".join(str(v) for v in b["center"] + b["size"])
                        f.write(f"{values}  # {b['name']}\n")
            else:
                c, sz = default_box(prot_path)
                prot_boxes = [{"center": c, "size": sz, "name": "whole protein"}]
                exhaustiveness = BLIND_EXHAUSTIVENESS
                print(
                    "No box available (no context.txt and no cavity found), using"
                    " the default box (blind docking over the whole protein):"
                    f" center {c}, size {sz}"
                )

        print(f"\n##### Protein [{p_idx}/{len(proteins)}]: {prot_file} #####\n")
        prot_summary = []
        pending = []

        def record(item, run):
            best, where = finalize_ligand(item, run, prot_file, table_header)
            prot_summary.append((item["out_filename"], item["lig_file"], best, where))
            all_summary.append(
                (prot_name, item["out_filename"], item["lig_file"], best, where)
            )
            print(
                f"     Done! Result saved to {prot_name}/docking/"
                f"{item['out_filename']}, best score: {best} ({where})\n"
            )

        for i, lig_file in enumerate(ligands, start=1):
            lig_path = os.path.join(lig_folder, lig_file)
            lig_name = os.path.splitext(lig_file)[0]
            out_filename = f"{lig_name}_docked.pdbqt"
            out_pdbqt = os.path.join(prot_results, out_filename)
            table_path = os.path.join(prot_results, f"{lig_name}_scores.txt")

            print(
                f"[{i}/{len(ligands)}] Processing ligand: {lig_file} ->"
                f" saving to {prot_name}/docking/{out_filename}"
            )

            runs = []
            tmp_files = []

            for k, box in enumerate(prot_boxes, start=1):
                tmp_pdbqt = os.path.join(prot_results, f"{lig_name}_tmp{k}.pdbqt")
                tmp_files.append(tmp_pdbqt)
                cmd = [
                    vina_path,
                    "--receptor", prot_path,
                    "--ligand", lig_path,
                    "--out", tmp_pdbqt,
                    "--center_x", str(box["center"][0]),
                    "--center_y", str(box["center"][1]),
                    "--center_z", str(box["center"][2]),
                    "--size_x", str(box["size"][0]),
                    "--size_y", str(box["size"][1]),
                    "--size_z", str(box["size"][2]),
                    "--exhaustiveness", str(exhaustiveness),
                    "--num_modes", str(NUM_MODES),
                ]

                try:
                    process = subprocess.run(
                        cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
                    )
                except Exception as e:
                    print(f"     An error occurred: {e}")
                    continue

                if process.returncode != 0:
                    print(
                        f"     Docking error for ligand {lig_file} ({box['name']}):"
                        f"\n{process.stderr}"
                    )
                    continue

                rows = [l for l in process.stdout.splitlines() if row_pattern.match(l)]
                if not rows:
                    continue
                value = float(rows[0].split()[1])
                if len(prot_boxes) > 1:
                    print(f"     {box['name']}: {value}")
                runs.append(
                    {"box": box, "value": value, "rows": rows, "tmp": tmp_pdbqt}
                )

            item = {
                "lig_file": lig_file,
                "out_filename": out_filename,
                "out_pdbqt": out_pdbqt,
                "table_path": table_path,
                "tmp_files": tmp_files,
                "runs": runs,
            }

            if not runs:
                print(f"     Docking failed for ligand {lig_file}.\n")
                for t in tmp_files:
                    if os.path.exists(t):
                        os.remove(t)
                continue

            if COMPARE_LIGANDS and len(prot_boxes) > 1:
                pending.append(item)  # decided after all ligands are docked
            else:
                record(item, min(runs, key=lambda r: r["value"]))

        if pending:
            # Pick one common cavity: the one with the best mean score over
            # all ligands (only cavities where every ligand was docked)
            scores = {}
            for idx, box in enumerate(prot_boxes):
                values = []
                for item in pending:
                    found_run = [r["value"] for r in item["runs"] if r["box"] is box]
                    if not found_run:
                        break
                    values.append(found_run[0])
                else:
                    scores[idx] = sum(values) / len(values)

            print(f"Mean best score over ligands for {prot_name}:")
            for idx, mean in scores.items():
                print(f"  {prot_boxes[idx]['name']}: {mean:.2f}")

            if scores:
                common = prot_boxes[min(scores, key=scores.get)]
                print(f"Common cavity for all ligands: {common['name']}\n")
                for item in pending:
                    run = next(r for r in item["runs"] if r["box"] is common)
                    record(item, run)
            else:
                print(
                    "No cavity was docked successfully for all ligands, so each"
                    " ligand uses its own best cavity.\n"
                )
                for item in pending:
                    record(item, min(item["runs"], key=lambda r: r["value"]))

        write_summary(
            os.path.join(results_root, prot_name, "summary"),
            ("result_file", "ligand", "best_affinity_kcal/mol", "box"),
            prot_summary,
            2,
        )

    write_summary(
        os.path.join(results_root, "summary_all"),
        ("protein", "result_file", "ligand", "best_affinity_kcal/mol", "box"),
        all_summary,
        3,
    )

    write_readme(results_root)

    print("=== [STAGE 2] All docking calculations finished successfully! ===\n")


CHIMERAX_DRIVER = '''from chimerax.core.commands import run, register, CmdDesc, IntArg

DATA = __DATA__
USE_KVFINDER = __USE_KVFINDER__
CAVITY_COLOR = "__CAVITY_COLOR__"


def model_ids():
    return {m.id for m in session.models.list() if m.id is not None}


def spec(model_id):
    return "#" + ".".join(str(i) for i in model_id)


def specs(ids):
    return "#" + ",".join(".".join(str(i) for i in m) for m in ids)


def open_model(path, extra=""):
    before = model_ids()
    run(session, 'open "%s" format pdb %s' % (path, extra))
    new = sorted(i for i in model_ids() - before if len(i) == 1)
    return new[0] if new else None


def add_cavities(protein_spec):
    if not USE_KVFINDER:
        return []
    before = model_ids()
    try:
        run(session, "kvfinder %s showTool false" % protein_spec)
    except Exception as err:
        print("kvfinder failed:", err)
        return []
    new = sorted(model_ids() - before)
    for model_id in new:
        run(session, "color %s %s" % (spec(model_id), CAVITY_COLOR))
    return new


def load_protein(path):
    protein_id = open_model(path)
    if protein_id is None:
        return None
    protein_spec = spec(protein_id)
    run(session, "hide %s atoms" % protein_spec)
    run(session, "cartoon %s" % protein_spec)
    run(session, "color %s gray" % protein_spec)
    cavity_ids = add_cavities(protein_spec)
    return protein_id, cavity_ids


def style_ligand(ligand_spec):
    run(session, "show %s atoms" % ligand_spec)
    run(session, "style %s stick" % ligand_spec)
    run(session, "color %s byhetero" % ligand_spec)


# ---------- Part 1: save snapshots of every pose ----------
for scene in DATA:
    run(session, "close session")
    if load_protein(scene["protein"]) is None:
        continue
    first_pose = True
    for pose in scene["poses"]:
        ligand_id = open_model(pose["file"])
        if ligand_id is None:
            continue
        ligand_spec = spec(ligand_id)
        style_ligand(ligand_spec)
        if first_pose:
            run(session, "view")
            first_pose = False
        run(session, 'save "%s" width 1200 height 900 supersample 3' % pose["shot"])
        run(session, "close %s" % ligand_spec)


# ---------- Part 2: interactive viewer for all proteins ----------
VIEWS = []
STATE = {"p": 0, "f": 0}


def build_views():
    run(session, "close session")
    for scene in DATA:
        loaded = load_protein(scene["protein"])
        if loaded is None:
            continue
        protein_id, cavity_ids = loaded
        group = [protein_id] + [i for i in cavity_ids if len(i) == 1]
        poses = []
        for pose in scene["poses"]:
            ligand_id = open_model(pose["file"])
            if ligand_id is None:
                continue
            style_ligand(spec(ligand_id))
            poses.append({"id": ligand_id, "label": pose["label"]})
        VIEWS.append({"name": scene["name"], "group": group, "poses": poses})


def apply_state(refit):
    view = VIEWS[STATE["p"]]
    everything = []
    for v in VIEWS:
        everything += v["group"] + [p["id"] for p in v["poses"]]
    run(session, "hide %s models" % specs(everything))
    shown = list(view["group"])
    if view["poses"]:
        shown.append(view["poses"][STATE["f"]]["id"])
    run(session, "show %s models" % specs(shown))
    if refit:
        run(session, "view")


def log_state():
    view = VIEWS[STATE["p"]]
    total = len(view["poses"])
    label = view["poses"][STATE["f"]]["label"] if total else "no poses"
    links = " | ".join(
        '<a href="cxcmd:dprot %d">%s</a>' % (i + 1, v["name"])
        for i, v in enumerate(VIEWS)
    )
    html = (
        "<b>Protein %d/%d: %s</b> | frame %d/%d: %s<br>"
        'Proteins: %s<br>'
        '<a href="cxcmd:dprev">&lt; prev frame</a> | '
        '<a href="cxcmd:dnext">next frame &gt;</a>'
        % (STATE["p"] + 1, len(VIEWS), view["name"], STATE["f"] + 1,
           max(total, 1), label, links)
    )
    session.logger.info(html, is_html=True)


def dprot(session, n):
    if not 1 <= n <= len(VIEWS):
        session.logger.warning("Protein number must be 1-%d" % len(VIEWS))
        return
    STATE["p"] = n - 1
    STATE["f"] = 0
    apply_state(True)
    log_state()


def dframe(session, n):
    total = len(VIEWS[STATE["p"]]["poses"])
    if not 1 <= n <= total:
        session.logger.warning("Frame number must be 1-%d" % total)
        return
    STATE["f"] = n - 1
    apply_state(False)
    log_state()


def dnext(session):
    total = len(VIEWS[STATE["p"]]["poses"])
    if total:
        STATE["f"] = (STATE["f"] + 1) % total
        apply_state(False)
        log_state()


def dprev(session):
    total = len(VIEWS[STATE["p"]]["poses"])
    if total:
        STATE["f"] = (STATE["f"] - 1) % total
        apply_state(False)
        log_state()


if DATA:
    build_views()
    if VIEWS:
        register("dprot", CmdDesc(required=[("n", IntArg)],
                                  synopsis="Show protein number n"), dprot)
        register("dframe", CmdDesc(required=[("n", IntArg)],
                                   synopsis="Show frame number n"), dframe)
        register("dnext", CmdDesc(synopsis="Next frame"), dnext)
        register("dprev", CmdDesc(synopsis="Previous frame"), dprev)
        apply_state(True)
        log_state()
'''


def short_ligand_names(names):
    """Cut the common prefix off ligand names: a_14, a_15 -> lig14, lig15."""
    names = list(names)
    result = {n: n for n in names}
    if len(names) < 2:
        return result
    prefix = os.path.commonprefix(names)
    cut = max(prefix.rfind("_"), prefix.rfind("-")) + 1
    if cut == 0:
        return result
    for n in names:
        rest = n[cut:]
        if not rest:
            return {m: m for m in names}
        result[n] = f"lig{rest}" if rest.isdigit() else rest
    if len(set(result.values())) < len(names):  # names must stay unique
        return {m: m for m in names}
    return result


def run_chimerax_rendering():
    print("=== [STAGE 3] Preparing ChimeraX commands ===")

    current_dir = base_dir()
    prot_folder = os.path.join(current_dir, "protein_output")
    results_root = os.path.join(current_dir, "results")
    temp_root = os.path.join(current_dir, "temp_poses")

    if not os.path.isdir(prot_folder) or not os.path.isdir(results_root):
        print("Error: protein_output or results folders not found.")
        return

    proteins = sorted(
        [f for f in os.listdir(prot_folder) if f.endswith(".pdbqt")],
        key=natural_key,
    )
    if not proteins:
        print("Error: no .pdbqt files in protein_output.")
        return

    scenes = []
    total_results = 0

    for prot_file in proteins:
        prot_name = os.path.splitext(prot_file)[0]
        prot_path = os.path.join(prot_folder, prot_file)
        prot_results = os.path.join(results_root, prot_name, "docking")

        if not os.path.isdir(prot_results):
            continue

        result_files = sorted(
            [f for f in os.listdir(prot_results) if f.endswith("_docked.pdbqt")],
            key=natural_key,
        )
        if not result_files:
            continue

        total_results += len(result_files)
        output_folder = os.path.join(results_root, prot_name, "snapshots")
        temp_folder = os.path.join(temp_root, prot_name)
        os.makedirs(output_folder, exist_ok=True)
        os.makedirs(temp_folder, exist_ok=True)

        # ChimeraX has no PDBQT opener, so convert everything to PDB
        prot_pdb = pdbqt_file_to_pdb(
            prot_path, os.path.join(temp_folder, f"{prot_name}_protein.pdb")
        )

        lig_names = [f[: -len("_docked.pdbqt")] for f in result_files]
        snap_names = (
            short_ligand_names(lig_names)
            if SHORT_SNAPSHOT_NAMES
            else {n: n for n in lig_names}
        )

        poses = []
        for res_file in result_files:
            lig_name = res_file[: -len("_docked.pdbqt")]

            with open(
                os.path.join(prot_results, res_file),
                "r",
                encoding="utf-8",
                errors="ignore",
            ) as f:
                content = f.read()

            pose_blocks = [
                block
                for block in content.split("ENDMDL")
                if any(l.startswith(("ATOM", "HETATM")) for l in block.splitlines())
            ][:MAX_POSES]

            for pose_idx, pose_content in enumerate(pose_blocks, start=1):
                temp_pose_path = os.path.join(
                    temp_folder, f"{lig_name}_pose{pose_idx}.pdb"
                )
                with open(temp_pose_path, "w", encoding="utf-8") as tf:
                    tf.write(pdbqt_text_to_pdb(pose_content))

                shot_path = os.path.join(
                    output_folder,
                    f"{prot_name}_{snap_names[lig_name]}_pose{pose_idx}.png",
                )
                match = re.search(r"REMARK VINA RESULT:\s+(-?\d+\.\d+)", pose_content)
                score = f"{match.group(1)} kcal/mol" if match else "n/a"
                poses.append(
                    {
                        "file": to_cx_path(temp_pose_path),
                        "shot": to_cx_path(shot_path),
                        "label": f"{lig_name} | pose {pose_idx} | {score}",
                    }
                )

        scenes.append(
            {
                "protein": to_cx_path(prot_pdb),
                "name": prot_name,
                "poses": poses,
            }
        )

    print(f"Result files found for rendering: {total_results}")

    if not scenes:
        return

    script_path = os.path.join(current_dir, "run_commands.py")
    script_text = (
        CHIMERAX_DRIVER.replace("__DATA__", json.dumps(scenes))
        .replace("__USE_KVFINDER__", str(bool(USE_KVFINDER)))
        .replace("__CAVITY_COLOR__", CAVITY_COLOR)
    )
    with open(script_path, "w", encoding="utf-8") as f:
        f.write(script_text)

    chimerax_path = find_chimerax()
    if not chimerax_path:
        print(
            "ChimeraX not found. Set CHIMERAX_PATH at the top of the script, or"
            f" open the file {script_path} in ChimeraX manually (File - Open)."
        )
        return

    print(f"Launching ChimeraX ({chimerax_path}) and passing the script...")
    subprocess.Popen([chimerax_path, script_path])


if __name__ == "__main__":
    run_preparation()
    run_docking()
    run_chimerax_rendering()
