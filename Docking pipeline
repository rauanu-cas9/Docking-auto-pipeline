# Internal constants (no need to change these)
AMINO_ACIDS = frozenset(
    {
        "ALA", "ARG", "ASN", "ASP", "CYS", "GLN", "GLU", "GLY", "HIS", "ILE",
        "LEU", "LYS", "MET", "PHE", "PRO", "SER", "THR", "TRP", "TYR", "VAL",
        "MSE", "HID", "HIE", "HIP", "CYX", "CYM",
    }
)
WATER_NAMES = ("HOH", "WAT", "H2O")
METAL_IONS = frozenset({"ZN", "MN", "FE", "FE2", "CU", "CU1", "CO", "NI", "MG"})
DEFAULT_CENTER = (0.0, 0.0, 0.0)
DEFAULT_SIZE = (20.0, 20.0, 20.0)

# AutoDock atom types -> chemical elements (for PDBQT -> PDB conversion)
AD_TO_ELEMENT = {"A": "C", "OA": "O", "NA": "N", "SA": "S", "HD": "H", "HS": "H"}


def natural_key(text):
    return [int(t) if t.isdigit() else t.lower() for t in re.split(r"(\d+)", text)]


def base_dir():
    return os.path.dirname(os.path.abspath(__file__))


def to_cx_path(path):
    return path.replace("\\", "/")


def find_vina():
    folder = base_dir()
    for name in sorted(os.listdir(folder)):
        low = name.lower()
        if low.startswith("vina") and low.endswith(".exe") and "split" not in low:
            return os.path.join(folder, name)
    return shutil.which("vina")


def find_chimerax():
    """Return the path to the ChimeraX executable, or None if not found."""
    if CHIMERAX_PATH:
        return CHIMERAX_PATH if os.path.isfile(CHIMERAX_PATH) else None

    for name in ("ChimeraX", "ChimeraX.exe", "chimerax"):
        found = shutil.which(name)
        if found:
            return found

    patterns = []
    for root in (
        os.environ.get("ProgramFiles"),
        os.environ.get("ProgramFiles(x86)"),
        os.path.join(os.environ.get("LOCALAPPDATA", ""), "Programs"),
    ):
        if root:
            patterns.append(os.path.join(root, "ChimeraX*", "bin", "ChimeraX.exe"))
    patterns += [
        "/Applications/ChimeraX*.app/Contents/MacOS/ChimeraX",
        "/usr/bin/chimerax",
        "/usr/local/bin/chimerax",
        "/opt/UCSF/ChimeraX*/bin/ChimeraX",
    ]

    candidates = []
    for pattern in patterns:
        candidates += glob.glob(pattern)
    if not candidates:
        return None
    # newest version last in natural order
    return sorted(candidates, key=natural_key)[-1]


def default_box(prot_path):
    xs, ys, zs = [], [], []
    with open(prot_path, "r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            if line.startswith(("ATOM", "HETATM")):
                try:
                    xs.append(float(line[30:38]))
                    ys.append(float(line[38:46]))
                    zs.append(float(line[46:54]))
                except ValueError:
                    continue
    if not xs:
        return list(DEFAULT_CENTER), list(DEFAULT_SIZE)
    center = [(min(v) + max(v)) / 2 for v in (xs, ys, zs)]
    size = [max(v) - min(v) + DEFAULT_BOX_PADDING for v in (xs, ys, zs)]
    return [round(c, 3) for c in center], [round(s, 3) for s in size]


def read_ligands(input_path, ext):
    if ext in (".sdf", ".mol"):
        suppl = Chem.SDMolSupplier(input_path, removeHs=False)
        return [m for m in suppl if m is not None]
    if ext == ".mol2":
        mol = Chem.MolFromMol2File(input_path, removeHs=False)
        return [mol] if mol else []
    if ext == ".pdb":
        mol = Chem.MolFromPDBFile(input_path, removeHs=False)
        return [mol] if mol else []
    return []


def classify_file(path):
    ext = os.path.splitext(path)[1].lower()
    if ext in (".sdf", ".mol", ".mol2"):
        return "ligand"
    if ext not in (".pdb", ".ent"):
        return None

    residues = set()
    has_atoms = False
    with open(path, "r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            if line.startswith("ENDMDL"):
                break
            if line.startswith(("ATOM", "HETATM")):
                has_atoms = True
                if line[17:20].strip().upper() in AMINO_ACIDS:
                    residues.add((line[21], line[22:27]))

    if not has_atoms:
        return None
    return "protein" if len(residues) >= MIN_PROTEIN_RESIDUES else "ligand"


def clear_pdbqt(folder):
    for name in os.listdir(folder):
        if name.lower().endswith(".pdbqt"):
            os.remove(os.path.join(folder, name))


def read_context(current_dir):
    context_path = os.path.join(current_dir, "context.txt")
    if not os.path.exists(context_path):
        return None, True

    try:
        with open(context_path, "r", encoding="utf-8") as f:
            content = f.read()
    except Exception as e:
        print(f"Error reading context.txt: {e}")
        return None, False

    parts = [float(p) for p in re.findall(r"-?\d+(?:\.\d+)?", content)]
    if len(parts) < 6:
        print(
            f"Error: context.txt contains {len(parts)} numbers (at least 6 are"
            " required)."
        )
        return None, False
    if len(parts) % 6 != 0:
        print(
            f"Warning: context.txt contains {len(parts)} numbers, which is not a"
            " multiple of 6. The last incomplete group is ignored."
        )
    # Each group of 6 numbers = one box: center x y z, size x y z
    boxes = [
        (parts[i : i + 3], parts[i + 3 : i + 6])
        for i in range(0, len(parts) - 5, 6)
    ]
    return boxes, True


def pdbqt_text_to_pdb(text, keep_models=False, skip_h=False, protein_only=False):
    """Convert PDBQT text to plain PDB text that ChimeraX can open.

    keep_models=True keeps MODEL/ENDMDL lines (for multi-pose files).
    skip_h=True drops hydrogen atoms.
    protein_only=True drops everything except standard amino acid residues.
    """
    out = []
    for line in text.splitlines():
        if line.startswith(("ATOM", "HETATM")):
            atype = line.split()[-1]
            element = AD_TO_ELEMENT.get(atype, atype.capitalize())
            if skip_h and element == "H":
                continue
            if protein_only and line[17:20].strip().upper() not in AMINO_ACIDS:
                continue
            record = line[:66].ljust(66)
            if record[17:20].strip().upper() not in AMINO_ACIDS:
                record = "HETATM" + record[6:]
            out.append(record + " " * 10 + element.rjust(2))
        elif line.startswith("TER"):
            out.append("TER")
        elif keep_models and line.startswith(("MODEL", "ENDMDL")):
            out.append(line.rstrip())
    return "\n".join(out) + "\nEND\n"


def pdbqt_file_to_pdb(src, dst, keep_models=False, skip_h=False, protein_only=False):
    with open(src, "r", encoding="utf-8", errors="ignore") as f:
        text = f.read()
    with open(dst, "w", encoding="utf-8") as f:
        f.write(pdbqt_text_to_pdb(text, keep_models, skip_h, protein_only))
    return dst


def load_pykvfinder():
    try:
        import pyKVFinder

        return pyKVFinder
    except ImportError:
        pass

    print("Missing library pyKVFinder. Installing via pip...")
